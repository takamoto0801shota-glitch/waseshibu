# ===========================================
# わせしぶ（Atlas）環境変数
# ===========================================
# ローカル: cp .env.example .env.local
# Railway: ダッシュボード → Variables に設定
# ===========================================

# --- 必須（認証） ---
# Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# --- 推奨（AI機能） ---
# 未設定時はルールベースにフォールバック
OPENAI_API_KEY=sk-...

# --- Railway / Next.js（通常は自動設定・手動不要） ---
# PORT=3000
# NODE_ENV=production

# --- 任意 ---
# NEXT_TELEMETRY_DISABLED=1
