# ===========================================
# わせしぶ（Atlas）環境変数
# ===========================================
# ローカル: cp .env.example .env.local
# Railway: ダッシュボード → Variables に設定
# ===========================================

# --- 必須（AI機能） ---
# リズム調整 (/api/rhythm) とロードマップ微調整 (/api/roadmap) で使用
# 未設定時はルールベースにフォールバック（動作はするがAI調整なし）
OPENAI_API_KEY=sk-...

# --- Railway / Next.js（通常は自動設定・手動不要） ---
# PORT=3000
# NODE_ENV=production

# --- 任意 ---
# NEXT_TELEMETRY_DISABLED=1
