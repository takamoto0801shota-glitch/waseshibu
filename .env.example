# ===========================================
# わせしぶ（Atlas）環境変数
# ===========================================
# ローカル: cp .env.example .env.local
# Railway: ダッシュボード → Variables に設定
# ===========================================

# --- 必須（認証）---
# Supabase Dashboard → Project Settings → API
# Railway では SUPABASE_* を推奨（再ビルド不要で反映）
SUPABASE_URL=https://abcdefghijklmnop.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.（ここにanon key全文を貼る）

# ローカル開発用（SUPABASE_* があればそちらを優先）
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- 推奨（AI機能） ---
OPENAI_API_KEY=sk-...
